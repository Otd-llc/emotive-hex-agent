{
    "name": "emotive-hex-agent",
    "version": "0.1.0",
    "description": "An extreme-lean build of the Emotive Engine for the Hex Cluster agent: one gem crystal, electric moments, stripped gestures, Blender-made assets.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "author": "One Thousand Drones LLC (new work); Joshua Tollette (Emotive Engine)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Otd-llc/emotive-hex-agent.git"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "sideEffects": [
        "src/3d/effects/elements/electricity.js",
        "src/core/gestures/elemental/electric/register-hex-agent.js"
    ],
    "scripts": {
        "build": "rollup -c",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run test/unit",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix",
        "format": "prettier --write \"src/**/*.{js,json}\"",
        "format:check": "prettier --check \"src/**/*.{js,json}\"",
        "clean": "node -e \"import('fs').then(fs => fs.rmSync('dist', {recursive: true, force: true}))\"",
        "size": "node scripts/size.mjs",
        "gate:gl": "node harness/gates/gl.mjs",
        "gate:teardown": "node harness/gates/teardown.mjs",
        "gate:states": "node harness/gates/states.mjs",
        "gate:flash": "node harness/gates/flash.mjs",
        "capture": "node harness/capture.mjs",
        "harness": "node harness/serve.mjs"
    },
    "peerDependencies": {
        "three": "~0.170.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@gltf-transform/cli": "^4.3.0",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@vitest/coverage-v8": "^4.1.0",
        "canvas": "^3.2.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "gif.js": "^0.2.0",
        "html-minifier-terser": "^7.2.0",
        "jsdoc": "^4.0.4",
        "jsdoc-to-markdown": "^9.1.2",
        "jsdom": "^29.0.0",
        "playwright-core": "^1.62.1",
        "prettier": "^3.6.2",
        "rollup": "^4.9.5",
        "rollup-plugin-analyzer": "^4.0.0",
        "rollup-plugin-bundle-size": "^1.0.3",
        "rollup-plugin-visualizer": "^7.0.1",
        "terser": "^5.46.1",
        "three": "0.170.0",
        "typedoc": "^0.28.16",
        "typedoc-plugin-markdown": "^4.11.0",
        "vitest": "^4.1.0"
    },
    "main": "dist/emotive-hex-agent.js",
    "module": "dist/emotive-hex-agent.js",
    "exports": {
        ".": {
            "import": "./dist/emotive-hex-agent.js"
        }
    },
    "files": [
        "dist/emotive-hex-agent.js",
        "LICENSE.md",
        "NOTICE"
    ]
}
